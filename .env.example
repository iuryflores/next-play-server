PORT=3001
HOST=127.0.0.1
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5174
MONGODB_URI=mongodb://127.0.0.1:27017/nextplay
ALLOW_REGISTRATION=true
EMAIL_VERIFICATION_REQUIRED=true

# Fotos privadas no S3. Credenciais também podem vir de uma IAM role.
AWS_REGION=sa-east-1
S3_BUCKET=nextplay-ij
SWAGGER_ENABLED=true

# Habilite a Books API no Google Cloud. A chave fica apenas no backend.
GOOGLE_BOOKS_API_KEY=

# Gmail: use senha de app com verificação em duas etapas, nunca a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# CLIENT_ORIGIN também define a origem dos links enviados por e-mail.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Login com Google e SMS serão configurados em uma próxima etapa.
# Não coloque credenciais em variáveis VITE_* nem no Git.
