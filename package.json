{
  "name": "nextplay-server",
  "version": "0.8.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.rotten-tomatoes.local --env-file-if-exists=.env --watch -r ts-node/register src/main.ts",
    "start:dev": "npm run dev",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env.rotten-tomatoes.local --env-file-if-exists=.env dist/main.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "check:version": "node scripts/check-version.mjs",
    "test:deploy": "node --test test-deploy/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "^12.0.5",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "1.4.7",
    "helmet": "^8.1.0",
    "mongoose": "9.9.5",
    "nodemailer": "^10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
