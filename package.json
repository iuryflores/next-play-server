{
  "name": "nextplay-server", "version": "0.1.0", "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch -r ts-node/register src/main.ts",
    "start:dev": "npm run dev",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1", "@nestjs/core": "12.0.1", "@nestjs/platform-express": "12.0.1",
    "@nestjs/mongoose": "12.0.0", "mongoose": "9.9.5", "reflect-metadata": "0.2.2", "rxjs": "7.8.2",
    "class-transformer": "0.5.1", "class-validator": "^0.14.3", "cookie-parser": "1.4.7", "helmet": "^8.1.0"
  },
  "devDependencies": {
    "ts-node": "10.9.2", "@types/express": "^5.0.0", "@types/cookie-parser": "^1.4.9", "@types/node": "^24.0.0", "typescript": "5.9.3"
  }
}
